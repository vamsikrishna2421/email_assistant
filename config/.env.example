# Jerry — local configuration
#
#   cp config/.env.example config/.env
#
# then fill in the values below. `scripts/start-n8n.sh` sources this file, and
# `scripts/import-credentials.sh` uses it to seed n8n's credential store so you
# never have to paste keys into the browser UI.
#
# config/.env is gitignored. Never commit it.

# ---------------------------------------------------------------------------
# Google Gemini  — powers all four agents (Master, Email, Calendar, Meeting)
# ---------------------------------------------------------------------------
# Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Google OAuth  — used by BOTH the Gmail and Google Calendar nodes
# ---------------------------------------------------------------------------
# From Google Cloud Console -> APIs & Services -> Credentials
# -> Create OAuth client ID -> Web application.
# See docs/SETUP.md for the full click-by-click walkthrough.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Fireflies.ai  — powers the Meeting Agent's transcript tools
# ---------------------------------------------------------------------------
# From https://app.fireflies.ai/integrations/custom/fireflies
FIREFLIES_API_KEY=

# ---------------------------------------------------------------------------
# n8n runtime (optional — sensible defaults are applied if left unset)
# ---------------------------------------------------------------------------
N8N_PORT=5678
N8N_DIAGNOSTICS_ENABLED=false

# Encrypts the credential store. Generated on first run if unset; once n8n has
# encrypted credentials with a key, changing it makes them unreadable.
# N8N_ENCRYPTION_KEY=
